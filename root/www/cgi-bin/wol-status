#!/bin/sh
# ==============================================================================
# wol-status (CGI) -- 给 LuCI 页面读状态
#   GET /cgi-bin/wol-status          -> 优先返回缓存（页面首屏快）
#   GET /cgi-bin/wol-status?fresh=1  -> 重新计算，内容有变化才覆盖缓存
# ==============================================================================

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

# 只允许内网 / Tailscale 来源访问（防止哪天 LuCI 暴露到公网时泄露信息）
case "${REMOTE_ADDR:-}" in
	127.*|::1|10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|100.*|fd*|fe80*) ;;
	*) printf '{"error":"forbidden"}\n'; exit 0 ;;
esac

CACHE=/tmp/wol-status.cache
FRESH=0
case "?${QUERY_STRING:-}" in
	*'?fresh=1'*) FRESH=1 ;;
esac

# 首屏直接用缓存，不再跑脚本
if [ "$FRESH" != "1" ] && [ -s "$CACHE" ]; then
	cat "$CACHE"
	exit 0
fi

out=$(/usr/bin/wol-status 2>&1)

case "$out" in
	\{*)
		# 内容没变就不写，变了才原子覆盖
		if [ "$out" != "$(cat "$CACHE" 2>/dev/null)" ]; then
			printf '%s\n' "$out" > "$CACHE.tmp" 2>/dev/null && mv "$CACHE.tmp" "$CACHE"
		fi
		printf '%s\n' "$out"
		;;
	*)
		# 把脚本真实报错暴露给前端，方便排查
		err=$(printf '%s' "$out" | head -c 400 | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' ')
		printf '{"error":"wol-status 执行异常: %s"}\n' "$err"
		;;
esac
exit 0
