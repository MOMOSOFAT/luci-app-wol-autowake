#!/bin/sh
# ==============================================================================
# wol-ctl (CGI) -- 执行动作
#
#   GET /cgi-bin/wol-ctl?q=wake:<名称|MAC|端口>        唤醒指定设备
#   GET /cgi-bin/wol-ctl?q=wakeall                     唤醒全部
#   GET /cgi-bin/wol-ctl?q=restart                     重启 wol-autowake 服务
#   GET /cgi-bin/wol-ctl?q=logclean                    立刻跑一次日志清理
#   GET /cgi-bin/wol-ctl?q=sync                        把全部设备同步到防火墙设置
#   GET /cgi-bin/wol-ctl?q=setfw:<名称|MAC|端口>:<0|1> 设置某台设备的「启用转发」并立刻生效
#   GET /cgi-bin/wol-ctl?q=block:<ip>                  把 IP 加入手动黑名单
#   GET /cgi-bin/wol-ctl?q=unblock:<ip>                把 IP 移出手动黑名单
#   GET /cgi-bin/wol-ctl?q=cnlist                      重建国内 IP 表
#   GET /cgi-bin/wol-ctl?q=cnlist_status               查看国内 IP 表状态
#
# 返回: {"ok":bool,"result":"..."}
#
# 安全说明: 只暴露【幂等】【无害】的动作 ——
#   · sync / setfw 完全以 UCI 配置为准，重复调用结果一样
#   · 唯一"副作用"是给规则补日志（自动唤醒的触发来源），不开放任何流量
#   · 只改 enabled / name / dest_*，绝不删除规则
# ==============================================================================

. /lib/functions.sh
. /usr/libexec/wol-fw.sh

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

case "${REMOTE_ADDR:-}" in
	127.*|::1|10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|100.*|fd*|fe80*) ;;
	*) printf '{"ok":false,"result":"forbidden"}\n'; exit 0 ;;
esac

jesc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' | tr '\n' ' '; }
emit() { printf '{"ok":%s,"result":"%s"}\n' "$1" "$(jesc "$2")"; }

# ------------------------------------------------------------------ URL 解码
q=$(printf '%s' "${QUERY_STRING:-}" \
	| sed -e 's/^.*[?&]q=//' -e 's/^q=//' -e 's/&.*$//' -e 's/+/ /g')
q=$(printf '%s' "$q" \
	| sed -e 's/%3[Aa]/:/g' -e 's/%2[Ff]/\//g' -e 's/%20/ /g' \
	      -e 's/%2[Dd]/-/g' -e 's/%2[Ee]/./g' -e 's/%5[Ff]/_/g')

config_load wol_autowake

# ------------------------------------------------------------------ 同步逻辑
SYNC_N=0; SYNC_CREATED=0; SYNC_ON=0; SYNC_OFF=0; SYNC_LOGFIX=0; SYNC_SKIP=0

# 同步单台设备：确保规则存在 -> 补日志 -> 应用启用状态
sync_one() {
	local s="$1" name port ip dport proto
	local res created sec ours nowen

	config_get name  "$s" name
	config_get port  "$s" port
	config_get ip    "$s" ip
	config_get dport "$s" dest_port
	config_get proto "$s" proto
	config_get_bool en "$s" fw_enabled 0

	if [ -z "$port" ] || [ -z "$ip" ]; then
		SYNC_SKIP=$((SYNC_SKIP + 1))
		return 0
	fi
	SYNC_N=$((SYNC_N + 1))

	res=$(fw_ensure "$port" "$ip" "${dport:-3389}" "${proto:-tcp}" "$en" "WOLAUTO-$port")
	[ -n "$res" ] || { SYNC_SKIP=$((SYNC_SKIP + 1)); return 0; }

	created=${res%%|*}; res=${res#*|}
	sec=${res%%|*};     res=${res#*|}
	ours=${res%%|*};    nowen=${res##*|}

	[ "$created" = "1" ] && SYNC_CREATED=$((SYNC_CREATED + 1))
	[ "$nowen" = "1" ]   && SYNC_ON=$((SYNC_ON + 1)) || SYNC_OFF=$((SYNC_OFF + 1))
	fw_has_log "$sec" && SYNC_LOGFIX=$((SYNC_LOGFIX + 1))

	# IPv6 放行：按设备的 ipv6_allow 决定建/删（IPv6 没有 NAT，只是一条 ACCEPT）
	config_get_bool v6 "$s" ipv6_allow 0
	case "$v6" in 1) ;; *) v6=0 ;; esac
	fw_ensure6 "$port" "$v6" "$v6" >/dev/null 2>&1 || true

	return 0
}

sync_all() {
	SYNC_N=0; SYNC_CREATED=0; SYNC_ON=0; SYNC_OFF=0; SYNC_LOGFIX=0; SYNC_SKIP=0
	config_foreach sync_one device

	# 内网走公网也触发唤醒的 nft 规则：按设置项生成 / 删除
	local hp
	config_get_bool hp settings wake_hairpin 0
	fw_hairpin "$hp" >/dev/null 2>&1

	fw_commit_reload
}

# ------------------------------------------------------------------ 按 端口/MAC/名称 找设备
FS_WANT=""
FS_FOUND=""

_find_match() {
	local s="$1" port mac name
	config_get port "$s" port
	config_get mac  "$s" mac
	config_get name "$s" name
	case "$port" in
		"") return 0 ;;
	esac
	case "$FS_WANT" in
		"$port"|"$mac"|"$name") FS_FOUND="$s" ;;
	esac
	return 0
}

find_section() {
	FS_WANT="$1"
	FS_FOUND=""
	config_foreach _find_match device
}

# ------------------------------------------------------------------ 本地归属地库
GEO_DB=/etc/wol-autowake/ip2region.db
GEO_URL1="https://gitee.com/hubo/ip2region/raw/v1.9.0/data/ip2region.db"
GEO_URL2="https://raw.githubusercontent.com/lionsoul2014/ip2region/v1.9.0/data/ip2region.db"

# 返回 need / skip:原因
geo_need() {
	local src pre size
	src=$(uci -q get wol_autowake.settings.geo_source 2>/dev/null)
	pre=$(uci -q get wol_autowake.settings.geo_precise 2>/dev/null)
	[ "$src" = "local" ] && [ "$pre" = "1" ] || { echo "skip:未启用本地精确查询"; return 1; }
	[ -s "$GEO_DB" ] || { echo "need"; return 0; }
	size=$(wc -c < "$GEO_DB" 2>/dev/null || echo 0)
	[ "${size:-0}" -ge 5000000 ] || { echo "need"; return 0; }
	echo "skip:本地库已存在"
	return 1
}

geo_download() {
	local tmp size
	mkdir -p /etc/wol-autowake
	tmp="$GEO_DB.tmp"
	rm -f "$tmp"

	if ! curl -fsSL --max-time 180 -o "$tmp" "$GEO_URL1" 2>/dev/null; then
		curl -fsSL --max-time 300 -o "$tmp" "$GEO_URL2" 2>/dev/null || {
			rm -f "$tmp"
			echo "下载失败：本地库源不可达（Gitee / GitHub 都失败）"
			return 1
		}
	fi

	size=$(wc -c < "$tmp" 2>/dev/null || echo 0)
	if [ "${size:-0}" -lt 5000000 ]; then
		rm -f "$tmp"
		echo "下载失败：文件不完整（${size:-0} 字节，应约 7MB）"
		return 1
	fi

	mv "$tmp" "$GEO_DB" || {
		rm -f "$tmp"
		echo "下载失败：无法写入 $GEO_DB"
		return 1
	}
	rm -f /root/wol-geo.cache /root/wol-geo.stamp
	echo "local-precise" > /root/wol-geo.mode
	/usr/bin/wol-geo >/dev/null 2>&1
	echo "本地库下载完成（$((size / 1024 / 1024)) MB），归属地已更新"
	return 0
}

# ------------------------------------------------------------------ 分发
case "$q" in
	restart)
		out=$(/etc/init.d/wol-autowake restart 2>&1)
		emit true "${out:-服务已重启}"
		;;

	wakeall)
		out=$(/usr/bin/wol-wake --all 2>&1)
		emit true "$out"
		;;

	wake:*)
		arg=${q#wake:}
		out=$(/usr/bin/wol-wake "$arg" 2>&1)
		emit true "$out"
		;;

	logclean)
		rm -f /tmp/wol-logclean.ts 2>/dev/null
		out=$(/usr/bin/wol-logclean 2>&1)
		emit true "${out:-日志清理已执行}"
		;;

	logbackup)
		ts=$(date '+%Y%m%d-%H%M%S')
		dst="/root/wol-autowake.log.bak-$ts"
		if [ -s /root/wol-autowake.log ] && cp /root/wol-autowake.log "$dst" 2>/dev/null; then
			emit true "日志已备份到 $dst"
		else
			emit false "日志备份失败（日志为空或无法写入）"
		fi
		;;

	# ---- 重建 / 查看国内 IP 表 ----
	cnlist)
		out=$(/usr/bin/wol-cnlist build 2>&1)
		emit true "${out:-操作完成}"
		;;

	cnlist_status)
		out=$(/usr/bin/wol-cnlist status 2>&1)
		emit true "$out"
		;;

	# ---- 本地归属地库 ----
	# ---- 单个 IP 归属地查询 ----
	geo:*)
		ip=${q#geo:}
		case "$ip" in
			''|*[!0-9a-fA-F:./]*) emit false "IP 格式不对"; exit 0 ;;
		esac
		text=""
		if [ -f /etc/wol-autowake/ip2region.db ] && [ -x /usr/bin/wol-geo-lookup ]; then
			region=$(printf '%s\n' "$ip" | /usr/bin/wol-geo-lookup /etc/wol-autowake/ip2region.db 2>/dev/null | cut -f2)
			if [ -n "$region" ]; then
				country=${region%%|*}; rest=${region#*|}
				province=${rest%%|*}; rest=${rest#*|}
				city=${rest%%|*}
				text="$country"
				[ -n "$province" ] && [ "$province" != "$country" ] && text="$text $province"
				[ -n "$city" ] && [ "$city" != "$province" ] && text="$text $city"
			fi
		fi
		if [ -z "$text" ]; then
			resp=$(wget -q -T 4 -O - "http://ip-api.com/json/$ip?lang=zh-CN&fields=status,country,regionName,city" 2>/dev/null)
			if [ -n "$resp" ]; then
				status=$(printf '%s' "$resp" | jsonfilter -e '@.status' 2>/dev/null)
				if [ "$status" = "success" ]; then
					country=$(printf '%s' "$resp" | jsonfilter -e '@.country' 2>/dev/null)
					province=$(printf '%s' "$resp" | jsonfilter -e '@.regionName' 2>/dev/null)
					city=$(printf '%s' "$resp" | jsonfilter -e '@.city' 2>/dev/null)
					text="$country"
					[ -n "$province" ] && [ "$province" != "$country" ] && text="$text $province"
					[ -n "$city" ] && [ "$city" != "$province" ] && text="$text $city"
				fi
			fi
		fi
		[ -z "$text" ] && text="未知"
		printf '%s\t%s\t%s\n' "$ip" "$(date +%s)" "$text" >> /root/wol-geo.cache 2>/dev/null
		emit true "$text"
		;;

	geodl:check)
		out=$(geo_need)
		emit true "$out"
		;;

	geodl:force)
		out=$(geo_download); st=$?
		[ "$st" = "0" ] && emit true "$out" || emit false "$out"
		;;

	geodl)
		out=$(geo_need)
		if [ "$out" != "need" ]; then
			emit true "$out"
			exit 0
		fi
		out=$(geo_download); st=$?
		[ "$st" = "0" ] && emit true "$out" || emit false "$out"
		;;

	# ---- 手动黑名单 ----
	setblacklist:*)
		val=${q#setblacklist:}
		BL_FILE=/etc/wol-autowake/blacklist.list
		AUTO_FILE=/etc/wol-autowake/autoblack.list
		mkdir -p /etc/wol-autowake
		printf '%s' "$val" | tr ';' '\n' | while IFS='|' read -r ip exp src; do
			[ -n "$ip" ] || continue
			case "$exp" in ''|*[!0-9]*) exp=0 ;; esac
			case "$src" in auto|manual) ;; *) src=manual ;; esac
			printf '%s\t%s\t%s\n' "$ip" "$exp" "$src"
		done > "$BL_FILE.tmp" && mv "$BL_FILE.tmp" "$BL_FILE"
		awk -F'\t' '$3 == "auto" { print $1 "\t" $2 }' "$BL_FILE" > "$AUTO_FILE" 2>/dev/null
		emit true "已保存黑名单"
		;;

	block:*)
		ip=${q#block:}
		[ -n "$ip" ] || { emit false "缺少 IP"; exit 0; }
		cur=$(uci -q get wol_autowake.settings.blacklist)
		case " $cur " in
			*" $ip "*) emit true "$ip 已经在黑名单里了"; exit 0 ;;
		esac
		uci set "wol_autowake.settings.blacklist=$cur $ip"
		uci commit wol_autowake
		BL_FILE=/etc/wol-autowake/blacklist.list
		mkdir -p /etc/wol-autowake
		awk -F'\t' -v ip="$ip" '$1 != ip' "$BL_FILE" > "$BL_FILE.tmp" 2>/dev/null
		printf '%s\t0\tmanual\n' "$ip" >> "$BL_FILE.tmp"
		mv "$BL_FILE.tmp" "$BL_FILE"
		/etc/init.d/wol-autowake restart >/dev/null 2>&1
		emit true "已把 $ip 加入黑名单并重启服务"
		;;

	setlist:*)
		arg=${q#setlist:}
		key=${arg%%:*}
		val=${arg#*:}
		case "$key" in
			whitelist|blacklist) ;;
			*) emit false "未知名单类型"; exit 0 ;;
		esac
		uci set "wol_autowake.settings.$key=$val"
		uci commit wol_autowake
		emit true "已保存 $key"
		;;

	unblock:*)
		ip=${q#unblock:}
		[ -n "$ip" ] || { emit false "缺少 IP"; exit 0; }
		changed=0

		# 手动黑名单：在才删
		cur=$(uci -q get wol_autowake.settings.blacklist)
		case " $cur " in
			*" $ip "*)
				new=$(printf '%s' "$cur" | tr ' ,;' '\n\n\n' | grep -vxF "$ip" | tr '\n' ' ')
				uci set "wol_autowake.settings.blacklist=$new"
				uci commit wol_autowake
				changed=1
				;;
		esac

		# 自动黑名单：在才删
		if [ -f /etc/wol-autowake/autoblack.list ] \
			&& awk -F'\t' -v ip="$ip" '$1 == ip { found=1 } END { exit !found }' /etc/wol-autowake/autoblack.list; then
			awk -F'\t' -v ip="$ip" '$1 != ip' /etc/wol-autowake/autoblack.list \
				> /etc/wol-autowake/autoblack.list.tmp 2>/dev/null \
				&& mv /etc/wol-autowake/autoblack.list.tmp /etc/wol-autowake/autoblack.list
			changed=1
		fi

		# 统一黑名单文件里也要删
		BL_FILE=/etc/wol-autowake/blacklist.list
		if [ -f "$BL_FILE" ] \
			&& awk -F'\t' -v ip="$ip" '$1 == ip { found=1 } END { exit !found }' "$BL_FILE"; then
			awk -F'\t' -v ip="$ip" '$1 != ip' "$BL_FILE" > "$BL_FILE.tmp" 2>/dev/null \
				&& mv "$BL_FILE.tmp" "$BL_FILE"
			changed=1
		fi

		# ipset 里还有残留（旧预设/旧条目）：重启后按手动+自动重建
		if ipset test wol_bl4 "$ip" >/dev/null 2>&1; then
			changed=1
		fi

		if [ "$changed" = "0" ]; then
			emit true "$ip 不在黑名单，跳过"
			exit 0
		fi

		# 24 小时内不要再自动加回来（窗口内次数还高，否则下一分钟又被加进去）
		mkdir -p /etc/wol-autowake
		SKIP=/etc/wol-autowake/autoblack.skip
		if [ -f "$SKIP" ]; then
			awk -F'\t' -v ip="$ip" '$1 != ip' "$SKIP" > "$SKIP.tmp" 2>/dev/null \
				&& mv "$SKIP.tmp" "$SKIP"
		fi
		printf '%s\t%s\n' "$ip" "$(( $(date +%s) + 86400 ))" >> "$SKIP"

		/etc/init.d/wol-autowake restart >/dev/null 2>&1
		emit true "已把 $ip 从黑名单移除并重启服务"
		;;

	# ---- 设置某台设备的「启用转发」并立刻生效 ----
	setfw:*)
		arg=${q#setfw:}
		want=${arg%:*}
		val=${arg##*:}

		case "$val" in
			0|1) ;;
			*) emit false "参数必须是 0 或 1（收到：$val）"; exit 0 ;;
		esac
		[ -n "$want" ] || { emit false "缺少设备标识"; exit 0; }

		find_section "$want"
		[ -n "$FS_FOUND" ] || { emit false "没找到设备：$want"; exit 0; }

		uci set "wol_autowake.$FS_FOUND.fw_enabled=$val"
		uci commit wol_autowake

		# ★ 关键：重新加载配置，否则 sync_all 读到的是旧值（同 setv6）
		config_load wol_autowake
		sync_all

		if [ "$val" = "1" ]; then
			emit true "已启用转发（$want）：规则生效，端口对外开放"
		else
			emit true "已停用转发（$want）：规则保留但保持停用，端口不对外开放"
		fi
		;;

	# ---- 设置某台设备的「IPv6 放行」并立刻生效 ----
	setv6:*)
		arg=${q#setv6:}
		want=${arg%:*}
		val=${arg##*:}

		case "$val" in
			0|1) ;;
			*) emit false "参数必须是 0 或 1（收到：$val）"; exit 0 ;;
		esac
		[ -n "$want" ] || { emit false "缺少设备标识"; exit 0; }

		find_section "$want"
		[ -n "$FS_FOUND" ] || { emit false "没找到设备：$want"; exit 0; }

		uci set "wol_autowake.$FS_FOUND.ipv6_allow=$val"
		uci commit wol_autowake

		# ★ 关键：重新加载配置，否则下面的 sync_all 读到的还是旧值
		#   （config_get 是读内存里的配置，uci set 不会自动刷新）
		config_load wol_autowake
		sync_all

		if [ "$val" = "1" ]; then
			emit true "已开启 IPv6 放行（$want）"
		else
			emit true "已关闭 IPv6 放行（$want）：规则已移除，IPv6 不再可达"
		fi
		;;

	# ---- 把设备配置同步到防火墙设置 ----
	sync)
		sync_all
		if [ "$SYNC_N" = "0" ]; then
			emit true "没有需要同步的设备（规则需要设备同时填了「外部端口」和「内网 IP」）"
		else
			emit true "已同步 $SYNC_N 台设备：新建规则 $SYNC_CREATED 条；启用 $SYNC_ON 条 / 停用 $SYNC_OFF 条；日志已开 $SYNC_LOGFIX 条$([ "$SYNC_SKIP" -gt 0 ] && echo "；跳过 $SYNC_SKIP 台（缺 IP 或端口）")"
		fi
		;;

	"")
		emit false "缺少 q 参数"
		;;

	*)
		emit false "未知动作：$q"
		;;
esac
exit 0
