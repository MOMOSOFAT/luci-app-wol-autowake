#!/bin/sh
# ==============================================================================
# wol-wake  --  手动唤醒 / 设备列表
#   wol-wake                  列出所有设备和在线状态
#   wol-wake <名称|MAC|端口>   唤醒指定设备
#   wol-wake --all            唤醒全部
#
# 设备名允许含空格 -> 用 config_foreach 遍历，不做字符串拆分
# ==============================================================================

. /lib/functions.sh

IFACE="br-lan"
MODE="list"
ARG=""
FOUND=0
RC=0

load_cfg() {
	config_load wol_autowake
	config_get IFACE settings iface "br-lan"
}

online() {
	[ -z "$1" ] && { echo "?"; return; }
	if ping -c 1 -W 1 "$1" >/dev/null 2>&1; then echo "online"; else echo "offline"; fi
}

do_wake() {
	local name="$1" mac="$2" ip="$3"
	printf "%-24s %-20s %-16s " "$name" "$mac" "$ip"
	if etherwake -b -i "$IFACE" "$mac" >/dev/null 2>&1; then
		echo "OK 魔术包已发送"
		logger -t wol-wake "手动唤醒 $name ($mac)"
		printf '%s  唤醒 [%s] 手动唤醒 端口=- 来源=\n' \
			"$(date '+%Y-%m-%d %H:%M:%S')" "$name" >> /root/wol-autowake.log 2>/dev/null
		return 0
	fi
	echo "FAIL 发送失败（装一下 etherwake）"
	return 1
}

# list 模式
show_dev() {
	local s="$1" name port mac ip en
	config_get name "$s" name
	config_get port "$s" port
	config_get mac  "$s" mac
	config_get ip   "$s" ip
	config_get_bool en "$s" enabled 1
	printf "%-24s %-20s %-16s %-8s %s\n" \
		"${name:-$mac}" "$mac" "${ip:--}" "$(online "$ip")" \
		"$([ "$en" = "1" ] && echo '' || echo '(已停用)')"
}

# wake 模式
wake_match() {
	local s="$1" want="$2" name port mac ip en
	config_get name "$s" name
	config_get port "$s" port
	config_get mac  "$s" mac
	config_get ip   "$s" ip
	config_get_bool en "$s" enabled 1
	[ "$en" = "1" ] || return 0
	case "$want" in
		"$port"|"$mac") ;;
		*) [ -n "$name" ] && [ "$want" = "$name" ] || return 0 ;;
	esac
	FOUND=1
	do_wake "${name:-$mac}" "$mac" "$ip" || RC=1
}

wake_all() {
	local s="$1" name mac ip en
	config_get name "$s" name
	config_get mac  "$s" mac
	config_get ip   "$s" ip
	config_get_bool en "$s" enabled 1
	[ "$en" = "1" ] || return 0
	FOUND=1
	do_wake "${name:-$mac}" "$mac" "$ip" || RC=1
}

load_cfg

case "$1" in
	""|list)
		MODE=list
		;;
	--all)
		MODE=all
		ARG="--all"
		;;
	*)
		MODE=wake
		ARG="$1"
		;;
esac

case "$MODE" in
	list)
		printf "%-24s %-20s %-16s %-8s\n" "名称" "MAC" "IP" "状态"
		printf "%-24s %-20s %-16s %-8s\n" "----" "---" "--" "----"
		config_foreach show_dev device
		echo ""
		echo "用法: wol-wake <名称|MAC|端口>   |   wol-wake --all"
		;;
	all)
		config_foreach wake_all device
		[ "$FOUND" = "0" ] && { echo "没有启用的设备"; exit 1; }
		;;
	wake)
		config_foreach wake_match device "$ARG"
		if [ "$FOUND" = "0" ]; then
			echo "没找到匹配 '$ARG' 的设备。不带参数运行可查看列表。"
			exit 1
		fi
		;;
esac

exit $RC
